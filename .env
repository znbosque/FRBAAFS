APP_NAME="FRBAAFS"
APP_ENV=local
APP_KEY=base64:N609jm3VWzN0ORG74j7FRZhbac9nDGjQbw7hRTaLbpk=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Timezone used for attendance dates/times (change to your local timezone, e.g. Asia/Manila)
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# For background SMS sending instead, use:
# QUEUE_CONNECTION=database  +  php artisan queue:work

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# MAIL - real email verification & password reset mails are sent through SMTP.
# Fill in real credentials, e.g. Gmail App Password:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=yourgmail@gmail.com
#   MAIL_PASSWORD=your-16-char-app-password
# While MAIL_MAILER=log, emails are written to storage/logs/laravel.log.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=02.codingsystem@gmail.com
MAIL_PASSWORD=yljfuvicgnitzuvq
MAIL_FROM_ADDRESS="02.codingsystem@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# SMS - driver used to text parents when a student is marked present.
#   log    -> messages are written to storage/logs/laravel.log (default)
#   twilio -> real SMS via your Twilio account (fill in the values below)
#   http   -> any custom HTTP gateway (SMS_HTTP_URL / SMS_HTTP_* fields)
# ---------------------------------------------------------------------------
SMS_DRIVER=log
SMS_FROM="FRBAAFS"

# Twilio (https://www.twilio.com)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Generic HTTP gateway (POST JSON: { to, from, message })
SMS_HTTP_URL=

# Face recognition match threshold (Euclidean distance, lower is stricter; 0.6 recommended)
FACE_MATCH_THRESHOLD=0.6

# Time (H:i) after which students are marked "late"
SCHOOL_STARTS=08:00

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
